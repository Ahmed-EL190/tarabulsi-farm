rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function canRead() { return signedIn() && role() in ['admin','entry','viewer']; }
    function canWrite() { return signedIn() && role() in ['admin','entry']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function newDocOk() { return request.resource.data.archived == false && request.resource.data.createdBy == request.auth.uid; }
    function sameOwner() { return request.resource.data.createdBy == resource.data.createdBy; }

    match /settings/{d} { allow read: if canRead(); allow write: if isAdmin(); }
    match /exchangeRates/{d} { allow read: if canRead(); allow create: if isAdmin() && request.resource.data.rate > 0; allow update: if isAdmin() && sameOwner(); allow delete: if false; }
    match /auditLogs/{d} { allow read: if isAdmin(); allow create: if canWrite() && request.resource.data.by == request.auth.uid; allow update, delete: if false; }
    match /importJobs/{d} { allow read, write: if isAdmin(); }
    // Financial records: never hard-deleted (archive via update); owner/creator is immutable.
    match /{col}/{d} {
      allow read: if canRead() && col in ['milkTransactions','milkProduction','cattle','cattleEvents','landTransactions','partnerExpenses','partnerLedger'];
      allow create: if canWrite() && col in ['milkTransactions','milkProduction','cattle','cattleEvents','landTransactions','partnerExpenses','partnerLedger'] && (isAdmin() || newDocOk());
      allow update: if canWrite() && col in ['milkTransactions','milkProduction','cattle','cattleEvents','landTransactions','partnerExpenses','partnerLedger'] && sameOwner();
      allow delete: if false;
    }
  }
}
